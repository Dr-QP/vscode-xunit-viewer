{
  "name": "vscode-xunit-viewer",
  "publisher": "Dr-QP",
  "displayName": "XUnit Viewer",
  "description": "Generate and browse ROS 2 and colcon XUnit test results inside VS Code.",
  "version": "0.1.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "ros",
    "ros2",
    "colcon",
    "catkin",
    "xunit",
    "junit",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dr-QP/vscode-extensions"
  },
  "packageManager": "bun@1.3.10",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/package.xml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-xunit-viewer.openReport",
        "title": "Open XUnit Test Results",
        "category": "XUnit"
      },
      {
        "command": "vscode-xunit-viewer.refreshReport",
        "title": "Refresh XUnit Test Results",
        "category": "XUnit"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "XUnit Viewer",
      "properties": {
        "vscode-xunit-viewer.resultsPath": {
          "type": "string",
          "default": "build",
          "description": "Path to the folder that contains colcon and CTest XML results."
        },
        "vscode-xunit-viewer.outputPath": {
          "type": "string",
          "default": "build/xunit-index.html",
          "description": "Path where the generated xunit-viewer HTML report is written."
        },
        "vscode-xunit-viewer.title": {
          "type": "string",
          "default": "",
          "description": "Optional custom title for the generated test report. Leave empty to use the workspace name."
        },
        "vscode-xunit-viewer.ignorePatterns": {
          "type": "array",
          "default": [
            "Test.xml",
            "coverage.xml",
            "package.xml"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns ignored while scanning the results directory (matched relative to the results path)."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run ./scripts/build.mjs",
    "package": "bun run build && bunx @vscode/vsce package",
    "package:dev": "bun run build && bunx @vscode/vsce package -o vscode-xunit-viewer-dev.vsix",
    "test": "bunx jest --runInBand",
    "test:watch": "bunx jest --watch"
  },
  "dependencies": {
    "xunit-viewer": "^10.6.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "jest": "^30.2.0"
  }
}
